# Local development environment variables (Phase 0 walking skeleton +
# Phase 1 free-scraper slice). Every value below is an obviously-fake
# placeholder. Copy this file to .env (which is git-ignored) before
# running `make up`. Do not put real secrets in either file -- none are
# required through Phase 1.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-locally

DATABASE_URL=postgresql+asyncpg://scraper:change-me-locally@pgbouncer:6432/scraper
REDIS_URL=redis://redis:6379/0
MOCK_STORE_BASE_URL=http://mock-store:4000

MINIO_ROOT_USER=scraper-minio-admin
MINIO_ROOT_PASSWORD=change-me-locally

NEXT_PUBLIC_API_URL=http://localhost:8000

HTTP_WORKER_CONCURRENCY=2
BROWSER_WORKER_CONCURRENCY=2

SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=15

# --- Phase 2 (doc 18) -------------------------------------------------
# §4.1: the scheduler's real claim-and-dispatch poll loop (scheduler
# service only), distinct from the heartbeat above.
SCHEDULER_CLAIM_INTERVAL_SECONDS=10
SCHEDULER_CLAIM_BATCH_SIZE=20

# §1.1 / doc 07 §5: the reconciliation sweep (scheduler service only).
RECONCILIATION_INTERVAL_SECONDS=120
RECONCILIATION_STUCK_TASK_TIMEOUT_MINUTES=10

# §7.5: retention purge (scheduler service only). 90 days is amendment 6's
# literal value; the hourly run cadence is this implementation's own
# judgment call, distinct from the ~10s claim-poll cadence.
HISTORY_RETENTION_DAYS=90
RETENTION_PURGE_INTERVAL_SECONDS=3600

# §7.3: the production deployment guard (api service only). Set to "true"
# only once you have deliberately decided to run the unauthenticated
# /sources, /runs, /products, and /api/v1/scrapes endpoints in a
# production-flagged deployment -- see app/main.py's own docstring for
# exactly what this guard does and does not protect against.
UNAUTHENTICATED_SOURCE_API_ACK=false

# --- Phase 3 (doc 19) -------------------------------------------------
# Task idempotency and per-domain politeness defaults. These values are
# consumed by the Phase 3 worker coordination layer.
TASK_IDEMPOTENCY_TTL_SECONDS=600
DOMAIN_MAX_CONCURRENCY=3
DOMAIN_RATE_LIMIT_SECONDS=2
DOMAIN_COOLDOWN_SECONDS=600
