# Local development environment variables for the Phase 0 walking skeleton.
# Every value below is an obviously-fake placeholder. Copy this file to
# .env (which is git-ignored) before running `make up`. Do not put real
# secrets in either file during Phase 0 -- none are required yet.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-locally

DATABASE_URL=postgresql+asyncpg://scraper:change-me-locally@pgbouncer:6432/scraper
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=scraper-minio-admin
MINIO_ROOT_PASSWORD=change-me-locally

NEXT_PUBLIC_API_URL=http://localhost:8000

HTTP_WORKER_CONCURRENCY=2
BROWSER_WORKER_CONCURRENCY=2

SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=15
